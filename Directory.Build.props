<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>VellumText contributors</Authors>
    <Product>VellumText</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lurebat/VellumText</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lurebat/VellumText</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>avalonia;richtext;editor;wysiwyg;text</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Source link comes from the SDK, so debugging into a package needs no extra reference. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Only the shipping libraries are packed. Without this the test projects
    produce packages too, which is noise at best and published by accident at
    worst.

    GeneratePackageOnBuild is deliberately *not* set. It would put packing on
    the inner development loop, where it is pure cost, to catch metadata
    mistakes that CI already catches on every push: the `pack` job in ci.yml
    packs each change, so a missing Description or a broken README path fails
    there rather than at release time.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    The public API of every shipping package is recorded in PublicAPI.Shipped.txt and
    PublicAPI.Unshipped.txt beside its project, and the analyzer fails the build (warnings are
    errors) on any public or protected member that is added, removed or changed without the
    files saying so. That makes an API change a reviewed diff in those files rather than an
    accident. Unshipped holds what has not been in a release; when a version ships, its
    Unshipped lines move to Shipped. See CONTRIBUTING.md.
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

</Project>

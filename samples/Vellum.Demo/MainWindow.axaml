<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vellum="clr-namespace:Vellum.Avalonia;assembly=Vellum.Avalonia"
        x:Class="Vellum.Demo.MainWindow"
        Title="Vellum demo"
        Width="1180" Height="820"
        MinWidth="760" MinHeight="480">

  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="TextBlock.group">
      <Setter Property="Margin" Value="8,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="ToggleButton.tool">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#40808080" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="*,Auto,360" RowDefinitions="Auto,*,Auto">

    <!-- Toolbar -->
    <Border Grid.Row="0" Grid.ColumnSpan="3" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="8,6">
      <StackPanel>
        <WrapPanel>
          <Button x:Name="UndoButton" Classes="tool" Content="Undo"
                  IsEnabled="{Binding #View.CanUndo}" />
          <Button x:Name="RedoButton" Classes="tool" Content="Redo"
                  IsEnabled="{Binding #View.CanRedo}" />

          <TextBlock Classes="group" Text="BLOCK" />
          <Button x:Name="BodyButton" Classes="tool" Content="Body" />
          <Button x:Name="H1Button" Classes="tool" Content="H1" />
          <Button x:Name="H2Button" Classes="tool" Content="H2" />
          <Button x:Name="H3Button" Classes="tool" Content="H3" />
          <Button x:Name="QuoteButton" Classes="tool" Content="Quote" />
          <Button x:Name="CodeButton" Classes="tool" Content="Code" />

          <TextBlock Classes="group" Text="ALIGN" />
          <Button x:Name="AlignLeftButton" Classes="tool" Content="Left" />
          <Button x:Name="AlignCenterButton" Classes="tool" Content="Centre" />
          <Button x:Name="AlignRightButton" Classes="tool" Content="Right" />
          <Button x:Name="AlignJustifyButton" Classes="tool" Content="Justify" />

          <TextBlock Classes="group" Text="INDENT" />
          <Button x:Name="OutdentButton" Classes="tool" Content="&#x2190;" />
          <Button x:Name="IndentButton" Classes="tool" Content="&#x2192;" />
        </WrapPanel>

        <WrapPanel Margin="0,6,0,0">
          <TextBlock Classes="group" Text="TEXT" Margin="0,0,6,0" />
          <ToggleButton x:Name="BoldButton" Classes="tool" FontWeight="Bold" Content="B"
                        ToolTip.Tip="Bold (Ctrl+B)" />
          <ToggleButton x:Name="ItalicButton" Classes="tool" FontStyle="Italic" Content="I"
                        ToolTip.Tip="Italic (Ctrl+I)" />
          <ToggleButton x:Name="UnderlineButton" Classes="tool" Content="U"
                        ToolTip.Tip="Underline (Ctrl+U)">
            <ToggleButton.Styles>
              <Style Selector="ToggleButton#UnderlineButton /template/ ContentPresenter">
                <Setter Property="TextBlock.TextDecorations" Value="Underline" />
              </Style>
            </ToggleButton.Styles>
          </ToggleButton>
          <ToggleButton x:Name="StrikeButton" Classes="tool" Content="S"
                        ToolTip.Tip="Strikethrough (Ctrl+Shift+X)">
            <ToggleButton.Styles>
              <Style Selector="ToggleButton#StrikeButton /template/ ContentPresenter">
                <Setter Property="TextBlock.TextDecorations" Value="Strikethrough" />
              </Style>
            </ToggleButton.Styles>
          </ToggleButton>
          <ToggleButton x:Name="SuperButton" Classes="tool" Content="x&#x00B2;"
                        ToolTip.Tip="Superscript (Ctrl+.)" />
          <ToggleButton x:Name="SubButton" Classes="tool" Content="x&#x2082;"
                        ToolTip.Tip="Subscript (Ctrl+,)" />

          <TextBlock Classes="group" Text="FONT" />
          <ComboBox x:Name="FontBox" Width="150" Margin="0,0,4,0"
                    PlaceholderText="Family" />
          <ComboBox x:Name="SizeBox" Width="78" Margin="0,0,4,0"
                    PlaceholderText="Size" />

          <TextBlock Classes="group" Text="COLOUR" />
          <Button x:Name="ColourButton" Classes="tool" ToolTip.Tip="Text colour">
            <StackPanel Orientation="Horizontal">
              <Border Classes="swatch" Background="{Binding #ColourButton.Tag}" />
              <TextBlock Text="A" />
            </StackPanel>
          </Button>
          <Button x:Name="HighlightButton" Classes="tool" ToolTip.Tip="Highlight">
            <StackPanel Orientation="Horizontal">
              <Border Classes="swatch" Background="{Binding #HighlightButton.Tag}" />
              <TextBlock Text="&#x25A0;" />
            </StackPanel>
          </Button>
          <Button x:Name="LinkButton" Classes="tool" Content="Link"
                  ToolTip.Tip="Turn the selection into a link to example.com" />
          <Button x:Name="ClearButton" Classes="tool" Content="Clear"
                  ToolTip.Tip="Strip character formatting (Ctrl+Space)" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- The editor -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" Padding="24,18"
                  HorizontalScrollBarVisibility="Disabled">
      <vellum:RichTextView x:Name="View" MinHeight="400" />
    </ScrollViewer>

    <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" ResizeDirection="Columns" />

    <!-- Import panel -->
    <Border Grid.Row="1" Grid.Column="2" BorderThickness="1,0,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="12,8">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,140">

        <TextBlock Grid.Row="0" Classes="h" Text="Import" />

        <WrapPanel Grid.Row="1">
          <Button x:Name="PasteButton" Classes="tool" Content="Paste from clipboard" />
          <Button x:Name="FormatsButton" Classes="tool" Content="What is on it?" />
        </WrapPanel>

        <WrapPanel Grid.Row="2" Margin="0,6,0,0">
          <Button x:Name="ImportHtmlButton" Classes="tool" Content="Import as HTML" />
          <Button x:Name="ImportRtfButton" Classes="tool" Content="Import as RTF" />
          <Button x:Name="SampleButton" Classes="tool" Content="Reset sample" />
        </WrapPanel>

        <TextBox Grid.Row="3" x:Name="SourceBox" Margin="0,8,0,0"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                 VerticalContentAlignment="Top"
                 PlaceholderText="Paste or type HTML or RTF source here, then use a button above." />

        <TextBlock Grid.Row="4" Classes="h" Text="What the importer had to give up" />

        <Border Grid.Row="5" BorderThickness="1" Padding="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <ScrollViewer>
            <SelectableTextBlock x:Name="DiagnosticsText" FontSize="11" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- Status -->
    <Border Grid.Row="2" Grid.ColumnSpan="3" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="10,4">
      <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.8" />
    </Border>
  </Grid>
</Window>
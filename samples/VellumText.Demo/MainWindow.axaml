<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:VellumText="clr-namespace:VellumText.Avalonia;assembly=VellumText.Avalonia"
        xmlns:demo="clr-namespace:VellumText.Demo"
        x:Class="VellumText.Demo.MainWindow"
        Title="VellumText"
        Width="1240" Height="860"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource Canvas}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- Picked from the scene rather than the category: a clipboard tool is read in whatever
             light the desktop happens to be in, so both variants are chosen, not inherited. -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Canvas" Color="#E9E9EC" />
          <SolidColorBrush x:Key="Chrome" Color="#F6F6F8" />
          <SolidColorBrush x:Key="Page" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Hairline" Color="#1F000000" />
          <SolidColorBrush x:Key="PageEdge" Color="#22000000" />
          <SolidColorBrush x:Key="Ink" Color="#1B1B1F" />
          <SolidColorBrush x:Key="Muted" Color="#6B6B75" />
          <SolidColorBrush x:Key="Hover" Color="#14000000" />
          <SolidColorBrush x:Key="Sunken" Color="#0A000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Canvas" Color="#141416" />
          <SolidColorBrush x:Key="Chrome" Color="#1C1C1F" />
          <SolidColorBrush x:Key="Page" Color="#252529" />
          <SolidColorBrush x:Key="Hairline" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="PageEdge" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="Ink" Color="#EDEDF2" />
          <SolidColorBrush x:Key="Muted" Color="#9A9AA6" />
          <SolidColorBrush x:Key="Hover" Color="#18FFFFFF" />
          <SolidColorBrush x:Key="Sunken" Color="#22000000" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>

    <!-- Only the side panel's own buttons. The formatting bar's look ships with the control. -->
    <Style Selector=":is(Button).tool">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="236,*,Auto,340" RowDefinitions="Auto,*,Auto">

    <!-- The whole formatting bar, from the library. What used to be two hundred lines of markup
         and a hundred of code-behind here is now one element and one binding. -->
    <VellumText:RichTextToolbar Grid.Row="0" Grid.ColumnSpan="4" Editor="{Binding #Editor}" />

    <!-- The clipboard history: every import that has come through this window, each one a live
         rich-text rendering rather than a flattened string. These are RichTextViewer, not
         RichTextEditor — no caret, no keyboard, no undo stack, nothing a reader can reach. That
         is the entire reason the control exists, and a history is where it shows: fifty of these
         cost a fraction of fifty editors, and none of them is a tab stop. -->
    <Border Grid.Row="1" Grid.Column="0"
            Background="{DynamicResource Chrome}"
            BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Hairline}"
            Padding="14,14,10,14">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Classes="section" Text="HISTORY" />

        <ListBox Grid.Row="1" x:Name="HistoryList"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,8" />
              <Setter Property="CornerRadius" Value="7" />
              <Setter Property="Background" Value="Transparent" />
            </Style>
          </ListBox.Styles>

          <ListBox.ItemTemplate>
            <DataTemplate DataType="demo:HistoryEntry">
              <Border Background="{DynamicResource Page}"
                      BorderBrush="{DynamicResource PageEdge}" BorderThickness="1"
                      CornerRadius="7" Padding="10,9">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Label}" FontSize="10.5"
                             Foreground="{DynamicResource Muted}" />

                  <!-- Clipped rather than scrolled: a preview that scrolls invites a reader to
                       scroll it, and there is nothing down there worth the gesture. -->
                  <Border MaxHeight="84" ClipToBounds="True">
                    <VellumText:RichTextViewer Document="{Binding Doc}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Ink}"
                                           VerticalAlignment="Top" />
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- The document, on a page. The backdrop is what tells the eye where the page stops; an
         editor that fills the frame edge to edge reads as a text box.

         The page is the editor itself rather than a border wrapped around it, because the
         editor's scroll viewer must own the view directly for the layout to stay virtualized. -->
    <VellumText:RichTextEditor Grid.Row="1" Grid.Column="1"
                           x:Name="Editor"
                           MaxWidth="680"
                           Margin="28,28,28,48"
                           HorizontalAlignment="Stretch"
                           Background="{DynamicResource Page}"
                           BorderBrush="{DynamicResource PageEdge}" BorderThickness="1"
                           CornerRadius="8"
                           Padding="56,48"
                           FontSize="15.5"
                           FontFamily="Segoe UI Variable Text,Segoe UI,Inter,system-ui"
                           Foreground="{DynamicResource Ink}"
                           SmoothCaret="True"
                           CaretBlink="Smooth" />

    <!-- The find bar floats over the top-right of the page rather than pushing it down, so that
         opening it does not reflow the document the user is reading. Collapsed until Ctrl+F. -->
    <Border Grid.Row="1" Grid.Column="1"
            x:Name="FindBar"
            IsVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,40,44,0"
            Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
            CornerRadius="8" Padding="8,6"
            BoxShadow="0 6 20 0 #33000000">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBox x:Name="FindBox" Width="168" Height="28"
                 CornerRadius="6" FontSize="12"
                 VerticalContentAlignment="Center"
                 PlaceholderText="Find" />

        <TextBlock x:Name="FindCount" Width="52" FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Muted}" />

        <Button x:Name="FindPrevButton" Classes="tool" Content="&#x2191;" ToolTip.Tip="Previous (Shift+F3)" />
        <Button x:Name="FindNextButton" Classes="tool" Content="&#x2193;" ToolTip.Tip="Next (F3)" />

        <CheckBox x:Name="MatchCaseBox" Content="Aa" FontSize="11"
                  ToolTip.Tip="Match case" VerticalAlignment="Center" />
        <CheckBox x:Name="WholeWordBox" Content="W" FontSize="11"
                  ToolTip.Tip="Whole word" VerticalAlignment="Center" />

        <TextBox x:Name="ReplaceBox" Width="140" Height="28"
                 CornerRadius="6" FontSize="12"
                 VerticalContentAlignment="Center"
                 PlaceholderText="Replace with" />

        <Button x:Name="ReplaceButton" Classes="tool" Content="Replace" />
        <Button x:Name="ReplaceAllButton" Classes="tool" Content="All" />
        <Button x:Name="FindCloseButton" Classes="tool" Content="&#x2715;" ToolTip.Tip="Close (Esc)" />
      </StackPanel>
    </Border>

    <GridSplitter Grid.Row="1" Grid.Column="2" Width="1"
                  Background="Transparent" ResizeDirection="Columns" />

    <Border Grid.Row="1" Grid.Column="3"
            Background="{DynamicResource Chrome}"
            BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Hairline}"
            Padding="16,14">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,150">

        <TextBlock Grid.Row="0" Classes="section" Text="IMPORT" />

        <WrapPanel Grid.Row="1">
          <Button x:Name="PasteButton" Classes="tool" Content="Paste from clipboard" />
          <Button x:Name="FormatsButton" Classes="tool" Content="What is on it?" />
        </WrapPanel>

        <WrapPanel Grid.Row="2" Margin="0,4,0,0">
          <Button x:Name="ImportHtmlButton" Classes="tool" Content="As HTML" />
          <Button x:Name="ImportRtfButton" Classes="tool" Content="As RTF" />
          <Button x:Name="SampleButton" Classes="tool" Content="Reset sample" />
        </WrapPanel>

        <TextBox Grid.Row="3" x:Name="SourceBox" Margin="0,12,0,0"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5"
                 CornerRadius="6"
                 Background="{DynamicResource Sunken}"
                 BorderBrush="{DynamicResource Hairline}"
                 VerticalContentAlignment="Top"
                 PlaceholderText="Paste or type HTML or RTF source here, then use a button above." />

        <TextBlock Grid.Row="4" Classes="section" Margin="0,16,0,7"
                   Text="WHAT THE IMPORTER GAVE UP" />

        <Border Grid.Row="5" BorderThickness="1" Padding="8" CornerRadius="6"
                Background="{DynamicResource Sunken}"
                BorderBrush="{DynamicResource Hairline}">
          <ScrollViewer>
            <SelectableTextBlock x:Name="DiagnosticsText" FontSize="11.5" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Muted}" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="4"
            Background="{DynamicResource Chrome}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hairline}"
            Padding="14,6">
      <TextBlock x:Name="StatusText" FontSize="11.5"
                 Foreground="{DynamicResource Muted}" />
    </Border>
  </Grid>
</Window>

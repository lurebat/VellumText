<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VellumText.Demo.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />

    <!-- The formatting bar's default look. Without this the RichTextToolbar has no template
         and draws nothing at all. -->
    <StyleInclude Source="avares://VellumText.Avalonia/Themes/VellumText.axaml" />
  </Application.Styles>
</Application>
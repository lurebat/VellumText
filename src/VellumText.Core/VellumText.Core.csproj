<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>VellumText</RootNamespace>
    <Description>Headless rich text document model: nodes, positions, transactions, and history. No UI dependency.</Description>
  </PropertyGroup>

  <!--
    The node, embed and selection hierarchies are closed with private protected constructors
    (docs/architecture.md 9). The tests must still be able to derive: proving that the closed
    switches throw on an unrecognised type is exactly what says the closure is load-bearing, and
    there is no way to write that test from outside. Friendship rather than a wider public API.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="VellumText.Core.Tests" />
    <InternalsVisibleTo Include="VellumText.Avalonia.Tests" />
  </ItemGroup>

  <!--
    VellumText.Core deliberately has ZERO package references, not even Avalonia.Base
    (decided 2026-08-11, docs/architecture.md 12.1). This guard turns an accidental
    dependency into a build failure rather than a silent regression.

    The one exception is the public-API analyzer that Directory.Build.props adds to every
    shipping project. It runs inside the compiler and is PrivateAssets="all", so it never
    reaches the package's dependencies. It is exempted by name rather than by PrivateAssets,
    because a private *library* reference would compile and then be missing at run time.
  -->
  <Target Name="AssertNoDependencies" BeforeTargets="Build">
    <ItemGroup>
      <_CoreDependency Include="@(PackageReference)" Exclude="Microsoft.CodeAnalysis.PublicApiAnalyzers" />
    </ItemGroup>
    <Error Condition="'@(_CoreDependency)' != ''"
           Text="VellumText.Core must have no PackageReference. Found: @(_CoreDependency). See docs/architecture.md 4.1." />
    <Error Condition="'@(ProjectReference)' != ''"
           Text="VellumText.Core must have no ProjectReference. Found: @(ProjectReference)." />
  </Target>

  <ItemGroup>
    <!-- Two things in Core exist for its dependents rather than for a host: HeadingAppearance, which
         the editor and the RTF exporter must agree on, and InlineContent.Runs, the run-splitting scan
         every exporter needs. Neither is a model concept, so both stay out of the public API. -->
    <InternalsVisibleTo Include="VellumText.Avalonia" />
    <InternalsVisibleTo Include="VellumText.Interop.Html" />
    <InternalsVisibleTo Include="VellumText.Interop.Markdown" />
    <InternalsVisibleTo Include="VellumText.Interop.Rtf" />
    <InternalsVisibleTo Include="VellumText.Interop.Json" />
  </ItemGroup>

</Project>
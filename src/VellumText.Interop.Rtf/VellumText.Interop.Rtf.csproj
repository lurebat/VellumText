<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>VellumText.Interop.Rtf</RootNamespace>
    <Description>RTF import for the VellumText document model, by way of its HTML importer.</Description>
    <PackageTags>$(PackageTags);rtf;clipboard;import</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
  </ItemGroup>

  <!-- RtfImportOptions.ToHtmlOptions is the one place a new option can be silently forgotten, and
       it is internal precisely so the HTML type it produces stays out of this package's API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VellumText.Interop.Rtf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VellumText.Interop.Html\VellumText.Interop.Html.csproj" />
  </ItemGroup>

</Project>
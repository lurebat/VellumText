<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>VellumText.Interop.Rtf</RootNamespace>
    <Description>RTF import for the VellumText document model: OfficeIMO reads it, and the HTML importer decides what it may contain.</Description>
    <PackageTags>$(PackageTags);rtf;clipboard;import</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to one exact version (the brackets), by owner decision 2026-10-27: the reader is
         young and releases often, so an upgrade is a reviewed change, never a restore-time drift.
         See architecture.md §5.4. -->
    <PackageReference Include="OfficeIMO.Rtf" Version="[3.5.1]" />
    <PackageReference Include="OfficeIMO.Html.Rtf" Version="[3.5.1]" />
  </ItemGroup>

  <!-- RtfImportOptions.ToHtmlOptions is the one place a new option can be silently forgotten, and
       it is internal precisely so the HTML type it produces stays out of this package's API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VellumText.Interop.Rtf.Tests" />
    <InternalsVisibleTo Include="VellumText.Bench" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VellumText.Interop.Html\VellumText.Interop.Html.csproj" />
  </ItemGroup>

</Project>
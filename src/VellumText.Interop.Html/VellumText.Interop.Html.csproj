<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>VellumText.Interop.Html</RootNamespace>
    <Description>HTML import for the VellumText document model, with a strict sanitizing allow-list.</Description>
    <PackageTags>$(PackageTags);html;clipboard;import;sanitizer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <PackageReference Include="AngleSharp.Css" Version="1.1.2" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VellumText.Core\VellumText.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CssStyles.TryColor parses percentage channels that AngleSharp resolves to numbers before
         the importer sees them, so that branch is only reachable from a direct test. -->
    <InternalsVisibleTo Include="VellumText.Interop.Html.Tests" />

    <!-- SanitizingReader.NonContentElements is the one answer to "whose text is never content", and
         Markdown needs it before this package's sanitizer exists: its default path deletes raw HTML
         from the parsed Markdown, so nothing downstream is left to make the distinction. Shared
         rather than copied - a copy of a security list is a copy to forget to extend. -->
    <InternalsVisibleTo Include="VellumText.Interop.Markdown" />
    <InternalsVisibleTo Include="VellumText.Interop.Rtf" />
    <InternalsVisibleTo Include="VellumText.Interop.Rtf.Tests" />
  </ItemGroup>

</Project>
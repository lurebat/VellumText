<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:VellumText.Avalonia"
                    xmlns:c="clr-namespace:VellumText;assembly=VellumText.Core">

  <!--
    The default look of a RichTextToolbar.

    The control holds no buttons; this is where they are. An application that wants a different
    bar writes a different ControlTheme against the same properties and commands, which is the
    whole reason the two are separate. Every brush here is a DynamicResource with a fallback, so
    a host that defines VellumTextToolbarForeground and friends restyles the bar without replacing it.

    Icons are drawn rather than taken from an icon font: a machine without Segoe Fluent Icons
    would otherwise show a row of tofu.
  -->

  <StreamGeometry x:Key="VellumTextAlignLeftIcon">M1,2.5 H15 V4 H1 Z M1,6.5 H10 V8 H1 Z M1,10.5 H15 V12 H1 Z M1,14.5 H10 V16 H1 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextAlignCenterIcon">M1,2.5 H15 V4 H1 Z M3.5,6.5 H12.5 V8 H3.5 Z M1,10.5 H15 V12 H1 Z M3.5,14.5 H12.5 V16 H3.5 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextAlignRightIcon">M1,2.5 H15 V4 H1 Z M6,6.5 H15 V8 H6 Z M1,10.5 H15 V12 H1 Z M6,14.5 H15 V16 H6 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextAlignJustifyIcon">M1,2.5 H15 V4 H1 Z M1,6.5 H15 V8 H1 Z M1,10.5 H15 V12 H1 Z M1,14.5 H15 V16 H1 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextIndentIcon">M1,2.5 H15 V4 H1 Z M6,6.5 H15 V8 H6 Z M6,10.5 H15 V12 H6 Z M1,14.5 H15 V16 H1 Z M1,6 L4.5,9.25 L1,12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextOutdentIcon">M1,2.5 H15 V4 H1 Z M6,6.5 H15 V8 H6 Z M6,10.5 H15 V12 H6 Z M1,14.5 H15 V16 H1 Z M4.5,6 L1,9.25 L4.5,12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextBulletListIcon">M6,2.5 H15 V4 H6 Z M6,7.5 H15 V9 H6 Z M6,12.5 H15 V14 H6 Z M1,2 A1.4,1.4 0 1 1 1,4.9 A1.4,1.4 0 1 1 1,2 Z M1,7 A1.4,1.4 0 1 1 1,9.9 A1.4,1.4 0 1 1 1,7 Z M1,12 A1.4,1.4 0 1 1 1,14.9 A1.4,1.4 0 1 1 1,12 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextNumberListIcon">M6,2.5 H15 V4 H6 Z M6,7.5 H15 V9 H6 Z M6,12.5 H15 V14 H6 Z M1.6,1.6 H2.6 V4.9 H1.8 V2.4 H1.1 Z M0.9,6.6 H3.2 V7.4 L1.9,9.1 H3.3 V9.9 H0.8 V9.1 L2.1,7.4 H0.9 Z M0.9,11.6 H3.2 V12.3 L2.4,13 L3.3,13.6 V14.9 H0.9 V14.1 H2.4 V13.7 H1.5 V13 H2.3 V12.4 H0.9 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextUndoIcon">M6,3 L6,6 L2,6 Z M6,4.5 A6,6 0 1 1 3.2,10.8 L5,10.4 A4.2,4.2 0 1 0 7,6.2 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextRedoIcon">M10,3 L10,6 L14,6 Z M10,4.5 A6,6 0 1 0 12.8,10.8 L11,10.4 A4.2,4.2 0 1 1 9,6.2 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextLinkIcon">M6.2,9.8 A2.6,2.6 0 0 1 6.2,6.2 L8.4,4 A2.6,2.6 0 0 1 12,7.6 L10.8,8.8 L9.6,7.6 L10.8,6.4 A0.9,0.9 0 0 0 9.6,5.2 L7.4,7.4 A0.9,0.9 0 0 0 7.4,8.6 Z M9.8,6.2 A2.6,2.6 0 0 1 9.8,9.8 L7.6,12 A2.6,2.6 0 0 1 4,8.4 L5.2,7.2 L6.4,8.4 L5.2,9.6 A0.9,0.9 0 0 0 6.4,10.8 L8.6,8.6 A0.9,0.9 0 0 0 8.6,7.4 Z</StreamGeometry>
  <StreamGeometry x:Key="VellumTextClearIcon">M3,2.5 H13 V4.5 H9.2 L7.6,13.5 H5.4 L7,4.5 H3 Z M9.5,9 L14,13.5 L12.8,14.7 L8.3,10.2 Z</StreamGeometry>

  <ControlTheme x:Key="{x:Type v:RichTextToolbar}" TargetType="v:RichTextToolbar">
    <Setter Property="Background" Value="{DynamicResource VellumTextToolbarBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource VellumTextToolbarForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VellumTextToolbarBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,8" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Spacing="4">

            <!-- Structure: what the block is, and where it sits. -->
            <WrapPanel>
              <Button Classes="VellumText-tool"
                      Command="{Binding UndoCommand, RelativeSource={RelativeSource TemplatedParent}}"
                      IsEnabled="{Binding CanUndo, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                      ToolTip.Tip="Undo (Ctrl+Z)">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextUndoIcon}" />
              </Button>
              <Button Classes="VellumText-tool"
                      Command="{Binding RedoCommand, RelativeSource={RelativeSource TemplatedParent}}"
                      IsEnabled="{Binding CanRedo, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                      ToolTip.Tip="Redo (Ctrl+Y)">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextRedoIcon}" />
              </Button>

              <Border Classes="VellumText-divider" />

              <ToggleButton Classes="VellumText-tool" Content="Body" ToolTip.Tip="Body text"
                            Command="{Binding ToggleParagraphKindCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:ParagraphKind.Body}"
                            IsChecked="{Binding ParagraphKind, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Body}" />
              <ToggleButton Classes="VellumText-tool" Content="H1" ToolTip.Tip="Heading 1"
                            Command="{Binding ToggleParagraphKindCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:ParagraphKind.Heading1}"
                            IsChecked="{Binding ParagraphKind, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Heading1}" />
              <ToggleButton Classes="VellumText-tool" Content="H2" ToolTip.Tip="Heading 2"
                            Command="{Binding ToggleParagraphKindCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:ParagraphKind.Heading2}"
                            IsChecked="{Binding ParagraphKind, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Heading2}" />
              <ToggleButton Classes="VellumText-tool" Content="H3" ToolTip.Tip="Heading 3"
                            Command="{Binding ToggleParagraphKindCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:ParagraphKind.Heading3}"
                            IsChecked="{Binding ParagraphKind, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Heading3}" />
              <ToggleButton Classes="VellumText-tool" Content="Quote" ToolTip.Tip="Block quote"
                            Command="{Binding ToggleParagraphKindCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:ParagraphKind.Quote}"
                            IsChecked="{Binding ParagraphKind, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Quote}" />
              <ToggleButton Classes="VellumText-tool" Content="Code" ToolTip.Tip="Code block"
                            Command="{Binding ToggleParagraphKindCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:ParagraphKind.Code}"
                            IsChecked="{Binding ParagraphKind, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Code}" />

              <Border Classes="VellumText-divider" />

              <ToggleButton Classes="VellumText-tool" ToolTip.Tip="Align left"
                            Command="{Binding SetAlignCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextAlign.Left}"
                            IsChecked="{Binding Align, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Left}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextAlignLeftIcon}" />
              </ToggleButton>
              <ToggleButton Classes="VellumText-tool" ToolTip.Tip="Centre"
                            Command="{Binding SetAlignCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextAlign.Center}"
                            IsChecked="{Binding Align, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Center}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextAlignCenterIcon}" />
              </ToggleButton>
              <ToggleButton Classes="VellumText-tool" ToolTip.Tip="Align right"
                            Command="{Binding SetAlignCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextAlign.Right}"
                            IsChecked="{Binding Align, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Right}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextAlignRightIcon}" />
              </ToggleButton>
              <ToggleButton Classes="VellumText-tool" ToolTip.Tip="Justify"
                            Command="{Binding SetAlignCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextAlign.Justify}"
                            IsChecked="{Binding Align, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Justify}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextAlignJustifyIcon}" />
              </ToggleButton>

              <Border Classes="VellumText-divider" />

              <ToggleButton Classes="VellumText-tool" ToolTip.Tip="Bulleted list (Ctrl+Shift+8)"
                            Command="{Binding ToggleListCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:ListKind.Unordered}"
                            IsChecked="{Binding ListKind, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Unordered}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextBulletListIcon}" />
              </ToggleButton>
              <ToggleButton Classes="VellumText-tool" ToolTip.Tip="Numbered list (Ctrl+Shift+7)"
                            Command="{Binding ToggleListCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:ListKind.Ordered}"
                            IsChecked="{Binding ListKind, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Is}, ConverterParameter=Ordered}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextNumberListIcon}" />
              </ToggleButton>

              <Border Classes="VellumText-divider" />

              <Button Classes="VellumText-tool" ToolTip.Tip="Decrease indent"
                      Command="{Binding OutdentCommand, RelativeSource={RelativeSource TemplatedParent}}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextOutdentIcon}" />
              </Button>
              <Button Classes="VellumText-tool" ToolTip.Tip="Increase indent"
                      Command="{Binding IndentCommand, RelativeSource={RelativeSource TemplatedParent}}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextIndentIcon}" />
              </Button>
            </WrapPanel>

            <!-- Character: what the letters look like. -->
            <WrapPanel>
              <ToggleButton Classes="VellumText-tool" Content="B" FontWeight="Bold" FontSize="15"
                            ToolTip.Tip="Bold (Ctrl+B)"
                            Command="{Binding ToggleStyleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextStyle.Bold}"
                            IsChecked="{Binding IsBold, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
              <ToggleButton Classes="VellumText-tool" Content="I" FontStyle="Italic" FontSize="15"
                            FontFamily="Georgia,Times New Roman,serif"
                            ToolTip.Tip="Italic (Ctrl+I)"
                            Command="{Binding ToggleStyleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextStyle.Italic}"
                            IsChecked="{Binding IsItalic, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
              <ToggleButton Classes="VellumText-tool VellumText-underline" Content="U" FontSize="15"
                            ToolTip.Tip="Underline (Ctrl+U)"
                            Command="{Binding ToggleStyleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextStyle.Underline}"
                            IsChecked="{Binding IsUnderline, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
              <ToggleButton Classes="VellumText-tool VellumText-strike" Content="S" FontSize="15"
                            ToolTip.Tip="Strikethrough (Ctrl+Shift+X)"
                            Command="{Binding ToggleStyleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextStyle.Strikethrough}"
                            IsChecked="{Binding IsStrikethrough, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
              <ToggleButton Classes="VellumText-tool" Content="x&#x00B2;"
                            ToolTip.Tip="Superscript (Ctrl+.)"
                            Command="{Binding ToggleStyleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextStyle.Super}"
                            IsChecked="{Binding IsSuperscript, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
              <ToggleButton Classes="VellumText-tool" Content="x&#x2082;"
                            ToolTip.Tip="Subscript (Ctrl+,)"
                            Command="{Binding ToggleStyleCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CommandParameter="{x:Static c:TextStyle.Sub}"
                            IsChecked="{Binding IsSubscript, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

              <Border Classes="VellumText-divider" />

              <!--
                Editable lists rather than plain boxes: picking a font by typing its exact name
                is a memory test, and picking a size from eight guesses cannot set nine and a
                half. Editable gets both — the drop-down for the common case, typing for the rest.
                Enter commits the typed text, selecting an item commits that; the converters turn
                text into points and a value that is not a number is simply not applied.
              -->
              <ComboBox x:Name="PART_FontBox" Classes="VellumText-field" Width="150" IsEditable="True"
                        PlaceholderText="Font"
                        MaxDropDownHeight="320"
                        ItemsSource="{x:Static v:RichTextToolbar.FontFamilies}"
                        Text="{Binding SelectionFontFamily, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                        ToolTip.Tip="Font family — pick one, or type a name and press Enter">
                <ComboBox.KeyBindings>
                  <KeyBinding Gesture="Enter"
                              Command="{Binding SetFontFamilyCommand, RelativeSource={RelativeSource TemplatedParent}}"
                              CommandParameter="{Binding #PART_FontBox.Text}" />
                </ComboBox.KeyBindings>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox x:Name="PART_SizeBox" Classes="VellumText-field" Width="86" IsEditable="True"
                        PlaceholderText="Size"
                        MaxDropDownHeight="320"
                        ItemsSource="{x:Static v:RichTextToolbar.FontSizes}"
                        Text="{Binding SelectionFontSize, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static v:ToolbarConverters.Points}}"
                        ToolTip.Tip="Font size in points — pick one, or type a number and press Enter">
                <ComboBox.KeyBindings>
                  <KeyBinding Gesture="Enter"
                              Command="{Binding SetFontSizeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                              CommandParameter="{Binding #PART_SizeBox.Text}" />
                </ComboBox.KeyBindings>
              </ComboBox>

              <Border Classes="VellumText-divider" />

              <Button x:Name="PART_ForegroundButton" Classes="VellumText-tool" ToolTip.Tip="Text colour">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Classes="VellumText-swatch"
                          Background="{Binding SelectionForeground, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static v:ToolbarConverters.Swatch}}" />
                  <TextBlock Text="A" FontWeight="SemiBold" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Width="184" Spacing="6">
                      <Button Classes="VellumText-clear-colour" Content="No colour"
                              Command="{Binding SetForegroundCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                      <ItemsControl Classes="VellumText-palette"
                                    ItemsSource="{x:Static v:RichTextToolbar.Palette}"
                                    Tag="{Binding SetForegroundCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="PART_HighlightButton" Classes="VellumText-tool" ToolTip.Tip="Highlight">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Classes="VellumText-swatch"
                          Background="{Binding SelectionHighlight, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static v:ToolbarConverters.Swatch}}" />
                  <TextBlock Text="&#x25A0;" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Width="184" Spacing="6">
                      <Button Classes="VellumText-clear-colour" Content="No highlight"
                              Command="{Binding SetHighlightCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                      <ItemsControl Classes="VellumText-palette"
                                    ItemsSource="{x:Static v:RichTextToolbar.Palette}"
                                    Tag="{Binding SetHighlightCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <ToggleButton Classes="VellumText-tool" ToolTip.Tip="Link"
                            Command="{Binding SetLinkCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            IsChecked="{Binding IsLink, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextLinkIcon}" />
              </ToggleButton>
              <Button Classes="VellumText-tool" ToolTip.Tip="Strip character formatting (Ctrl+Space)"
                      Command="{Binding ClearFormattingCommand, RelativeSource={RelativeSource TemplatedParent}}">
                <Path Classes="VellumText-icon" Data="{StaticResource VellumTextClearIcon}" />
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

  </ControlTheme>

</ResourceDictionary>

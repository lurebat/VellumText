<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vellum.Interop.Html</RootNamespace>
    <Description>HTML import for the Vellum document model, with a strict sanitizing allow-list.</Description>
    <PackageTags>$(PackageTags);html;clipboard;import;sanitizer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="AngleSharp.Css" Version="1.0.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.982" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vellum.Core\Vellum.Core.csproj" />
  </ItemGroup>

</Project>
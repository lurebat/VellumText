<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      Avalonia.Headless.XUnit 12.1.1 depends on xunit.v3, which runs each test assembly as its
      own process. That makes the project an executable; without this the runner reports
      "Could not find app host executable" and discovers no tests at all.
    -->
    <OutputType>Exe</OutputType>

    <!-- A test's name is its documentation; CS1591 on every [Fact] is pure noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Reading back rendered pixels to prove something was actually drawn needs a pinned buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vellum.Avalonia\Vellum.Avalonia.csproj" />

    <!-- The control must not reference these, and does not. The tests must, because whether a
         real HTML or RTF flavour survives the clipboard is not answerable with a stub. -->
    <ProjectReference Include="..\..\src\Vellum.Interop.Html\Vellum.Interop.Html.csproj" />
    <ProjectReference Include="..\..\src\Vellum.Interop.Rtf\Vellum.Interop.Rtf.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      Avalonia.Headless.XUnit 12.1 depends on xunit.v3, which runs each test assembly as its
      own process. That makes the project an executable; without this the runner reports
      "Could not find app host executable" and discovers no tests at all.
    -->
    <OutputType>Exe</OutputType>

    <!-- A test's name is its documentation; CS1591 on every [Fact] is pure noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />

    <!-- Only the theme tests use it, and they need it: without a base theme a Window has no
         template, so it has no overlay layer, so a flyout cannot open at all. -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VellumText.Avalonia\VellumText.Avalonia.csproj" />

    <!-- The control must not reference these, and does not. The tests must, because whether a
         real HTML or RTF flavour survives the clipboard is not answerable with a stub. -->
    <ProjectReference Include="..\..\src\VellumText.Interop.Html\VellumText.Interop.Html.csproj" />
    <ProjectReference Include="..\..\src\VellumText.Interop.Rtf\VellumText.Interop.Rtf.csproj" />
    <ProjectReference Include="..\..\src\VellumText.Interop.Json\VellumText.Interop.Json.csproj" />
  </ItemGroup>

</Project>
